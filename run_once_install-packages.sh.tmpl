#!/usr/bin/env bash
# Installs pixi + global packages, zoxide, and tmux plugin manager.
# Runs once per rendered content; edit .chezmoidata/packages.yaml to trigger a re-run.
set -euo pipefail

export PATH="$HOME/.pixi/bin:$HOME/.local/bin:$PATH"

# --- pixi -------------------------------------------------------------------
if ! command -v pixi >/dev/null 2>&1; then
  echo "==> Installing pixi"
  curl -fsSL https://pixi.sh/install.sh | PIXI_NO_PATH_UPDATE=1 bash
fi

echo "==> Installing pixi global packages"
{{- range .pixi.simple }}
pixi global install {{ . | quote }}
{{- end }}
{{- range $env, $pkgs := .pixi.environments }}
pixi global install --environment {{ $env | quote }}{{ range $pkgs }} {{ . | quote }}{{ end }}
{{- end }}

# --- zoxide -----------------------------------------------------------------
if ! command -v zoxide >/dev/null 2>&1; then
  echo "==> Installing zoxide"
  curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

# --- tmux plugin manager ----------------------------------------------------
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPM_DIR" ]; then
  echo "==> Installing tpm"
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

if command -v tmux >/dev/null 2>&1; then
  echo "==> Installing tmux plugins"
  "$TPM_DIR/bin/install_plugins" || echo "warning: tmux plugin install failed; run prefix + I inside tmux"
fi

echo "==> Done"
